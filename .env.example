# Public — safe to expose in the browser bundle. From your Supabase project's
# API settings (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public — the site's own base URL, used to build auth email redirect links
# (e.g. request-access confirmation). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret — server-only, never exposed to the browser. Bypasses Row Level
# Security. From Project Settings → API → service_role key. Required for the
# admin-invite and forced-password-reset flows (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
